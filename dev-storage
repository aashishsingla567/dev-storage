#!/usr/bin/env python3
"""
dev-storage: Developer Storage & Lifecycle Management Utility for macOS.

Maintains tight storage budgets for iOS CoreSimulator runtimes & devices,
Android SDK system images & AVD emulators, Node.js runtime managers (mise/nvm),
package manager caches (npm/pnpm), and AI coding assistant local databases.
"""

import sys
import os
import subprocess
import shutil
import sqlite3
import argparse

VERSION = "1.0.0"

def run_cmd(cmd, check=False):
    res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    if check and res.returncode != 0:
        print(f"Error executing: {cmd}\n{res.stderr.strip()}", file=sys.stderr)
    return res.stdout.strip()

def get_dir_size(path):
    path = os.path.expanduser(path)
    if not os.path.exists(path):
        return 0
    total = 0
    try:
        for dirpath, _, filenames in os.walk(path):
            for f in filenames:
                fp = os.path.join(dirpath, f)
                if not os.path.islink(fp):
                    try:
                        total += os.path.getsize(fp)
                    except OSError:
                        pass
    except Exception:
        pass
    return total

def format_size(bytes_val):
    if bytes_val < 1024 * 1024:
        return f"{bytes_val / 1024:.1f} KB"
    elif bytes_val < 1024 * 1024 * 1024:
        return f"{bytes_val / (1024 * 1024):.1f} MB"
    else:
        return f"{bytes_val / (1024 * 1024 * 1024):.2f} GB"

def cmd_status():
    print("=" * 64)
    print(f" 🚀 DEVELOPER STORAGE & ALLOCATION AUDIT (v{VERSION})")
    print("=" * 64)
    
    # 1. Physical Drive Status
    df_output = run_cmd("df -h / | tail -1")
    parts = df_output.split()
    if len(parts) >= 4:
        size, used, avail, cap = parts[1], parts[2], parts[3], parts[4]
        print(f" Drive Partition : {size} total | {used} used | {avail} available ({cap} capacity)")
    print("-" * 64)
    
    # 2. iOS Simulators
    sim_dir = os.path.expanduser("~/Library/Developer/CoreSimulator")
    sim_size = get_dir_size(sim_dir)
    sim_runtimes = run_cmd("xcrun simctl list runtimes 2>/dev/null | grep -E '^iOS|^watchOS|^tvOS' || true")
    sim_count = run_cmd("xcrun simctl list devices 2>/dev/null | grep -c '(' || echo 0")
    print(f" [iOS Simulators] Target Budget: ~10 GB | Current: {format_size(sim_size)}")
    print(f"   • Devices configured : {sim_count.strip()}")
    if sim_runtimes:
        for r in sim_runtimes.splitlines():
            print(f"   • Installed runtime  : {r.strip()}")
    else:
        print("   • No active simulator runtimes detected.")
            
    # 3. Android SDK & AVDs
    avd_dir = os.path.expanduser("~/.android/avd")
    avd_size = get_dir_size(avd_dir)
    sysimg_dir = os.path.expanduser("~/Library/Android/sdk/system-images")
    sysimg_size = get_dir_size(sysimg_dir)
    print(f"\n [Android Emulators & SDK] Target Budget: ~14 GB | Current: {format_size(avd_size + sysimg_size)}")
    print(f"   • AVD user disks (~/.android/avd) : {format_size(avd_size)}")
    print(f"   • System Images (SDK)             : {format_size(sysimg_size)}")
    
    # 4. Node & Package Tooling Runtimes
    mise_installs = os.path.expanduser("~/.local/share/mise/installs")
    mise_size = get_dir_size(mise_installs)
    npm_cache = os.path.expanduser("~/.npm")
    npm_size = get_dir_size(npm_cache)
    pnpm_store = os.path.expanduser("~/.local/share/pnpm/store")
    pnpm_size = get_dir_size(pnpm_store)
    print(f"\n [Node & Package Runtimes] Target Budget: ~8 GB | Current: {format_size(mise_size + npm_size + pnpm_size)}")
    print(f"   • Mise managed versions           : {format_size(mise_size)}")
    print(f"   • npm tarball cache (~/.npm)      : {format_size(npm_size)}")
    print(f"   • pnpm global store               : {format_size(pnpm_size)}")

    # 5. Local Agent Database (OpenCode)
    opencode_db = os.path.expanduser("~/.local/share/opencode/opencode.db")
    if os.path.exists(opencode_db):
        db_size = os.path.getsize(opencode_db)
        print(f"\n [OpenCode Local Database] Target Budget: ~4 GB | Current: {format_size(db_size)}")
        try:
            conn = sqlite3.connect(opencode_db)
            cur = conn.cursor()
            cur.execute("SELECT count(*) FROM session;")
            s_count = cur.fetchone()[0]
            cur.execute("SELECT count(*) FROM session WHERE time_created < (strftime('%s', 'now', '-60 days') * 1000);")
            old_s = cur.fetchone()[0]
            print(f"   • Total sessions: {s_count} (eligible for prune >60d: {old_s})")
            conn.close()
        except Exception:
            pass

    print("=" * 64)
    print(" Quick Actions:")
    print("   dev-storage clean-sims      : Prune unavailable iOS simulators & wipe caches")
    print("   dev-storage wipe-avd        : Reset Android AVD user disks to clean state")
    print("   dev-storage clean-runtimes  : Run mise prune, npm cache clean & pnpm store prune")
    print("   dev-storage clean-opencode  : Prune sessions >60d and vacuum opencode.db")
    print("   dev-storage clean-all       : Run all safe prunes across categories")
    print("=" * 64)

def cmd_clean_sims():
    print("🧹 Cleaning iOS Simulators...")
    run_cmd("xcrun simctl delete unavailable 2>/dev/null")
    cache_dir = os.path.expanduser("~/Library/Developer/CoreSimulator/Caches")
    if os.path.exists(cache_dir):
        shutil.rmtree(cache_dir, ignore_errors=True)
        os.makedirs(cache_dir, exist_ok=True)
    print("✅ Removed unavailable devices and flushed CoreSimulator caches.")

def cmd_wipe_avd():
    print("🧹 Checking Android AVDs...")
    avd_dir = os.path.expanduser("~/.android/avd")
    if not os.path.exists(avd_dir):
        print("No AVD directory found.")
        return
    avds = [f.replace(".avd", "") for f in os.listdir(avd_dir) if f.endswith(".avd")]
    if not avds:
        print("No AVDs installed.")
        return
    for avd in avds:
        print(f"ℹ️  To wipe userdata bloat on '{avd}' (resets userdisk to ~300MB without re-downloading), run:")
        print(f"   emulator -avd {avd} -wipe-data")

def cmd_clean_runtimes():
    print("🧹 Pruning unused toolchains and package caches...")
    run_cmd("mise prune -y 2>/dev/null || true")
    run_cmd("npm cache clean --force 2>/dev/null || true")
    run_cmd("pnpm store prune 2>/dev/null || true")
    print("✅ Toolchains pruned with mise; npm cache and pnpm store cleaned.")

def cmd_clean_opencode(days=60):
    print(f"🧹 Compacting OpenCode sessions database (retention >{days} days)...")
    db_path = os.path.expanduser("~/.local/share/opencode/opencode.db")
    if not os.path.exists(db_path):
        print("opencode.db not found.")
        return
    try:
        conn = sqlite3.connect(db_path)
        cur = conn.cursor()
        cur.execute("PRAGMA foreign_keys = ON;")
        cutoff_ms = int((time.time() - days * 86400) * 1000)
        cur.execute("DELETE FROM session WHERE time_created < ?", (cutoff_ms,))
        deleted = cur.rowcount
        cur.execute("DELETE FROM event WHERE aggregate_id NOT IN (SELECT id FROM session);")
        cur.execute("DELETE FROM event_sequence WHERE aggregate_id NOT IN (SELECT id FROM session);")
        conn.commit()
        conn.close()
        
        conn = sqlite3.connect(db_path)
        conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
        conn.execute("VACUUM;")
        conn.close()
        print(f"✅ Pruned {deleted} old sessions and vacuumed opencode.db.")
    except Exception as e:
        print(f"❌ Error pruning opencode.db: {e}")

def cmd_clean_all():
    cmd_clean_sims()
    cmd_clean_runtimes()
    cmd_clean_opencode()
    print("\n🎉 All routine maintenance completed successfully.")
    cmd_status()

def main():
    parser = argparse.ArgumentParser(
        description="dev-storage: Developer Storage & Lifecycle Management Utility for macOS"
    )
    parser.add_argument(
        "-v", "--version", action="version", version=f"%(prog)s {VERSION}"
    )
    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    subparsers.add_parser("status", help="Show current storage allocations vs budgets")
    subparsers.add_parser("clean-sims", help="Prune unavailable iOS simulators and caches")
    subparsers.add_parser("wipe-avd", help="Instructions to reset Android AVD user disks")
    subparsers.add_parser("clean-runtimes", help="Prune unreferenced mise runtimes, npm and pnpm caches")
    
    p_opencode = subparsers.add_parser("clean-opencode", help="Prune older agent sessions and vacuum SQLite DB")
    p_opencode.add_argument("--days", type=int, default=60, help="Retention window in days (default: 60)")

    subparsers.add_parser("clean-all", help="Run all safe routine maintenance tasks")

    args = parser.parse_args()

    if args.command is None or args.command == "status":
        cmd_status()
    elif args.command == "clean-sims":
        cmd_clean_sims()
    elif args.command == "wipe-avd":
        cmd_wipe_avd()
    elif args.command == "clean-runtimes":
        cmd_clean_runtimes()
    elif args.command == "clean-opencode":
        cmd_clean_opencode(days=args.days)
    elif args.command == "clean-all":
        cmd_clean_all()

if __name__ == "__main__":
    main()
